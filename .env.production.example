# Production template. Copy to `.env.production`, replace every CHANGE_ME, run:
#
#   docker-compose --env-file .env.production up -d --build
#
# `.env.production` is gitignored. The --env-file flag is required and
# deliberate: compose only auto-loads `.env`, so production never starts by
# accident.

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_generated_password
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# The dev default is public knowledge. Generate: openssl rand -base64 32
SERVICE_TOKEN_DISCORD_BOT=CHANGE_ME_use_a_strong_generated_token

# Requires TLS in front of the stack. Keep true.
COOKIE_SECURE=true

# Only if the frontend is served from a different origin. Exact origins only.
CORS_ALLOWED_ORIGINS=

# --- Infisical (optional secret sourcing) ---
# Flip to true once a project exists and move the secrets above into it. Store
# only secrets there; database name, user and ports stay in this file.
#
# Postgres needs one bootstrap run against an empty volume, merging rather than
# replacing (--env-file reads one file, not both):
#   node scripts/infisical-env.ts
#   cat .env.production .env.infisical > .env.bootstrap
#   docker-compose --env-file .env.bootstrap up -d --build && rm .env.bootstrap
# After that, plain `docker-compose up`. See README §Secret Management.
INFISICAL_ENABLED=false

# EU Cloud. Use https://app.infisical.com for US, or your own origin.
INFISICAL_DOMAIN=https://eu.infisical.com

INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/

# The one pair that can't live in Infisical. Treat as a root credential and
# scope the identity to this project/environment. Or use a pre-issued
# INFISICAL_TOKEN, which skips the login call but is shorter-lived.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_TOKEN=
