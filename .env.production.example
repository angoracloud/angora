# Production environment template for docker-compose.
#
# Copy this file to `.env.production`, fill in real values (the
# POSTGRES_PASSWORD placeholder below must be replaced — it isn't a usable
# default), and run with:
#
#   docker-compose --env-file .env.production up -d --build
#
# `.env.production` is gitignored — never commit real production secrets.
# The `--env-file` flag is required: docker-compose only auto-loads a file
# literally named `.env`, so this one has to be passed explicitly every time
# (that's deliberate — it stops a production run from happening by accident).

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_generated_password
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# Shared secret the Discord bot authenticates to the backend with. MUST be
# replaced — the dev default in .env.example is public knowledge. Generate one
# with: openssl rand -base64 32
SERVICE_TOKEN_DISCORD_BOT=CHANGE_ME_use_a_strong_generated_token

# Keep this true in production: it stops browsers sending the session cookie
# over plain HTTP. Requires TLS terminating in front of the stack.
COOKIE_SECURE=true

# Leave empty unless the frontend is served from a different origin than the
# API. Wildcards are not accepted — credentialed requests need exact origins.
CORS_ALLOWED_ORIGINS=


# --- Infisical (optional secret sourcing) ---
# Recommended for a real deployment, once you have an Infisical project set up:
# flip this to true and move the secrets above into that project rather than
# keeping them in this file. Each service then resolves them at startup and
# refuses to boot if Infisical is unreachable, so a misconfiguration fails
# loudly instead of falling back to a placeholder.
#
# It ships off so a copied .env.production still boots before you get there —
# turning it on with the settings below unfilled is a deliberate startup failure.
#
# Secrets are read once at startup — rotating one requires a restart.
INFISICAL_ENABLED=false

# Infisical Cloud (EU). Use https://app.infisical.com for US Cloud, or your own
# origin for a self-hosted instance.
INFISICAL_DOMAIN=https://eu.infisical.com

INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/

# Machine identity credentials (Universal Auth). These are the one pair that
# cannot live in Infisical itself — treat them as the root credential and scope
# the machine identity to just this project/environment.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Alternative to the pair above: a pre-issued access token, which skips the
# login call. Shorter-lived, so usually only useful in CI.
INFISICAL_TOKEN=

# POSTGRES_PASSWORD is the exception: postgres is a third-party image that only
# reads it at initdb, so no in-process lookup can reach it. To source the whole
# compose file — postgres included — from Infisical:
#   node scripts/infisical-env.ts --out=.env.infisical
#   docker-compose --env-file .env.infisical up -d --build
