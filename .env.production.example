# Production environment template for docker-compose.
#
# Copy this file to `.env.production`, fill in real values (the
# POSTGRES_PASSWORD placeholder below must be replaced — it isn't a usable
# default), and run with:
#
#   docker-compose --env-file .env.production up -d --build
#
# `.env.production` is gitignored — never commit real production secrets.
# The `--env-file` flag is required: docker-compose only auto-loads a file
# literally named `.env`, so this one has to be passed explicitly every time
# (that's deliberate — it stops a production run from happening by accident).

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_generated_password
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# Shared secret the Discord bot authenticates to the backend with. MUST be
# replaced — the dev default in .env.example is public knowledge. Generate one
# with: openssl rand -base64 32
SERVICE_TOKEN_DISCORD_BOT=CHANGE_ME_use_a_strong_generated_token

# Keep this true in production: it stops browsers sending the session cookie
# over plain HTTP. Requires TLS terminating in front of the stack.
COOKIE_SECURE=true

# Leave empty unless the frontend is served from a different origin than the
# API. Wildcards are not accepted — credentialed requests need exact origins.
CORS_ALLOWED_ORIGINS=

