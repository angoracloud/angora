{
  "name": "angora",
  "private": true,
  "type": "module",
  "homepage": "https://angora.cloud",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "prepare": "husky",
    "check:dep-age": "node scripts/check-dependency-age.ts",
    "build:packages": "pnpm --filter @angora/secrets run build",
    "secrets:env": "node scripts/infisical-env.ts",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm run build:packages && pnpm --filter=\"!@angora/config\" -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:frontend": "pnpm --filter angora-frontend run dev",
    "dev:backend": "cd apps/backend && mvn compile exec:java"
  },
  "devDependencies": {
    "@angora/config": "workspace:*",
    "husky": "9.1.7",
    "prettier": "catalog:"
  }
}
