**/node_modules
**/dist
apps/backend
.git
*.log

# Real env files hold secrets in plaintext (.env, .env.production, and the
# .env.infisical that scripts/infisical-env.ts generates). The four root-context
# builds don't COPY them, but without this they'd still be uploaded into the
# build context on every build. The .example templates are tracked and harmless.
.env
.env.*
!.env.example
!.env.*.example
