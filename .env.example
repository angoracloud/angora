# Local development. Copy to `.env`; docker-compose loads it automatically.
#
# Every value here matches the default in docker-compose.yml, so the stack runs
# with no `.env` at all. Change one value without editing compose itself.
# For a production-like run, see .env.production.example.

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=angora
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# The backend and the Discord bot must both see this value: the backend stores
# its hash, the bot sends the raw token.
SERVICE_TOKEN_DISCORD_BOT=dev-discord-bot-token

# Sends the session cookie over HTTPS only. Breaks login on plain-HTTP dev.
COOKIE_SECURE=false

# Comma-separated origins for credentialed cross-origin requests. Empty is
# correct for every setup this repo ships, which is same-origin. No default is
# baked in: a value here grants that origin authenticated access. Wildcards are
# rejected. See README §Environment Variables.
CORS_ALLOWED_ORIGINS=

# --- Infisical (optional secret sourcing) ---
# Off by default. Set to true and each service resolves its secrets from
# Infisical at startup, falling back to the environment.
#
# Store only secrets in Infisical; database name, user and ports stay here.
# Postgres is the exception: its password is read at initdb, so it needs one
# bootstrap run. Merge rather than replace, since --env-file ignores this file:
#   node scripts/infisical-env.ts
#   cat .env .env.infisical > .env.bootstrap
#   docker-compose --env-file .env.bootstrap up -d --build && rm .env.bootstrap
# After that it's plain `docker-compose up`. See README §Secret Management.
INFISICAL_ENABLED=false

# EU Cloud. Use https://app.infisical.com for US, or your own origin.
INFISICAL_DOMAIN=https://eu.infisical.com

INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/

# Either the client pair, or a pre-issued token to skip the login call.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_TOKEN=
