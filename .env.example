# Local development environment for docker-compose.
#
# Copy this file to `.env` to override any of these values — docker-compose
# loads `.env` from the project root automatically, no extra flags needed.
# Every value below already matches the built-in default in
# docker-compose.yml, so `docker-compose up --build` works with zero setup
# even without a `.env` file at all; this file exists so you can change one
# value (e.g. a port that's already in use) without editing
# docker-compose.yml itself.
#
# For a production-like run with real secrets, see .env.production.example
# instead — don't reuse these dev-only credentials anywhere but your machine.

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=angora
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# Shared secret the Discord bot uses to authenticate its calls to the backend.
# The backend hashes this at startup and stores it in `service_tokens`; the bot
# sends the raw value as a bearer token. Both services must see the same value.
SERVICE_TOKEN_DISCORD_BOT=dev-discord-bot-token

# Marks the session cookie Secure, so browsers only send it over HTTPS. Local
# dev runs on plain HTTP, where that would stop login working — leave it false
# here and set it to true anywhere with TLS in front.
COOKIE_SECURE=false

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Empty is correct for docker-compose, where nginx serves the frontend on the
# same origin as the API. Set it to http://localhost:3000 if you run the
# frontend with `pnpm run dev:frontend` against a containerized backend.
CORS_ALLOWED_ORIGINS=

