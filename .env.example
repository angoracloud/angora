# Local development environment for docker-compose.
#
# Copy this file to `.env` to override any of these values — docker-compose
# loads `.env` from the project root automatically, no extra flags needed.
# Every value below already matches the built-in default in
# docker-compose.yml, so `docker-compose up --build` works with zero setup
# even without a `.env` file at all; this file exists so you can change one
# value (e.g. a port that's already in use) without editing
# docker-compose.yml itself.
#
# For a production-like run with real secrets, see .env.production.example
# instead — don't reuse these dev-only credentials anywhere but your machine.

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=angora
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=123456789012345678

# --- Authentication ---
# Shared secret the Discord bot uses to authenticate its calls to the backend.
# The backend hashes this at startup and stores it in `service_tokens`; the bot
# sends the raw value as a bearer token. Both services must see the same value.
SERVICE_TOKEN_DISCORD_BOT=dev-discord-bot-token

# Marks the session cookie Secure, so browsers only send it over HTTPS. Local
# dev runs on plain HTTP, where that would stop login working — leave it false
# here and set it to true anywhere with TLS in front.
COOKIE_SECURE=false

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Empty is correct in every setup this repo ships: docker-compose serves the
# frontend through nginx on the API's own origin, and `pnpm run dev:frontend`
# proxies /api to the backend from the Vite dev server, so the browser is
# same-origin there too. This is an escape hatch for a deployment that really
# does put the frontend on another origin.
#
# No default origin is baked in on purpose. The session cookie makes every
# request credentialed, so a value here grants that origin authenticated access
# — and a default would grant it everywhere the variable isn't overridden,
# production included. Wildcards are rejected outright (Ktor won't pair one
# with credentials); list exact origins.
CORS_ALLOWED_ORIGINS=


# --- Infisical (optional secret sourcing) ---
# Off by default: every value above is read straight from this file, exactly as
# it always has been. Set INFISICAL_ENABLED=true and each service resolves its
# own secrets from Infisical at startup instead, falling back to the environment
# for anything the project doesn't define.
#
# When it's on and Infisical can't be reached, services refuse to start rather
# than quietly booting on the dev defaults above — that's deliberate.
#
# Secrets are read once at startup, so rotating one needs a restart.
INFISICAL_ENABLED=false

# Infisical Cloud (EU). Use https://app.infisical.com for US Cloud, or your own
# origin (e.g. https://infisical.internal) for a self-hosted instance.
INFISICAL_DOMAIN=https://eu.infisical.com

# Which project, environment slug and folder to read. Required when enabled.
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/

# Machine identity credentials (Universal Auth). Either set both of these, or
# set INFISICAL_TOKEN below with a pre-issued access token to skip the login call.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_TOKEN=

# Note: POSTGRES_PASSWORD above can't be sourced in-process — postgres is a
# third-party image and only reads it at initdb. To feed compose itself from
# Infisical (which covers postgres and every other service), run:
#   node scripts/infisical-env.ts
#   docker-compose --env-file .env.infisical up -d --build
